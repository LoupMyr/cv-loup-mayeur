---
layout: layouts/base.liquid
---

<div class="container">
  <header class="row cv-header">
    <div class="col-md-4 d-flex justify-content-center align-items-center mb-4 mb-md-0">
      <img
        src="./../{{ cv.profile.picture}}"
        alt="{{ cv.profile.name }}"
        class="cv-picture rounded-circle">
    </div>
    <div class="cv-header-content col container d-flex flex-column gap-3">
      <div class="row">
        <div class="cv-profile-info col">
          <h1 class="cv-name">{{ cv.profile.name }}</h1>
          <h2 class="cv-title">{{ cv.profile.label }}</h2>
        </div>
        <div class="cv-contact col">
          <div class="contact-item">
            <i class="bi bi-geo-alt"></i>
            <span>{{ cv.profile.city }}, {{ cv.profile.postalCode }}</span>
          </div>
          <div class="contact-item">
            <i class="bi bi-cake"></i>
            <span>Né le {{ cv.profile.birth_date }}</span>
          </div>
          <div class="contact-item">
            <i class="bi bi-envelope"></i>
            <a href="mailto:{{ cv.profile.email }}">{{ cv.profile.email }}</a>
          </div>
          <div class="contact-item">
            <i class="bi bi-telephone"></i>
            <span>{{ cv.profile.phone }}</span>
          </div>
          <div class="contact-item socials d-flex gap-3">
            <a target="_blank" href="{{ cv.profile.linkedin }}">
              <i class="bi bi-linkedin"></i>
            </a>
            <a target="_blank" href="{{ cv.profile.github }}">
              <i class="bi bi-github"></i>
            </a>
          </div>
        </div>
      </div>
      <div class="row">
        <p>{{ cv.profile.summary }}</p>
      </div>
    </div>
  </header>
</div>

<main class="cv-main">
  <div class="container">
    <div class="row">
      {% comment %} Colonne de gauche: Languages / Interests {% endcomment %}
      <div class="col-md-5 col-lg-4 cv-main-left">

        <section class="language">
          <div class="language-title">
            <h3 class="cv-section-title">Langues</h3>
          </div>
          <div class="d-flex justify-content-center">
            {% include 'languagesList.liquid' %}
          </div>
        </section>

        <section class="softskills-interests mt-4">
          <div class="softskills-interests-title">
            <h3 class="cv-section-title">Softskills & Centres d'intérêt</h3>
          </div>
          <div class="row">
            <div class="col-lg-6 col-12 mb-3">
              <h4 class="h6 text-primary mb-2">Softskills</h4>
              {% include 'softskillsList.liquid' %}
            </div>
            <div class="col-lg-6 col-12 mb-3">
              <h4 class="h6 text-primary mb-2">Centres d'intérêt</h4>
              {% include 'interestsList.liquid' %}
            </div>
          </div>
        </section>
      </div>

      {% comment %} Colonne de droite: Compétences {% endcomment %}
      <div class="col cv-main-right d-flex">
        <section class="skill">
          <div class="skill-title">
            <h3 class="cv-section-title">Compétences</h3>
          </div>
          {% include 'skillsList.liquid' %}
        </section>
      </div>
    </div>
  </div>

  <div class="cv-main-center">
    <div class="container d-flex justify-content-center flex-column gap-5">
      <section class="work">
        <div class="work-title">
          <h3 class="cv-section-title">Expériences professionnelles</h3>
        </div>
        <div class="d-flex flex-column gap-4">
          {% include 'worksList.liquid' %}
        </div>
      </section>

      <section class="education">
        <div class="education-title">
          <h3 class="cv-section-title">Formation</h3>
        </div>
        <div class="d-flex flex-column gap-4">
          {% include 'educationList.liquid' %}
        </div>
      </section>

      <section class="projects">
        <div class="projects-title">
          <h3 class="cv-section-title">Projets</h3>
        </div>
        <div class="d-flex flex-column gap-4">
          {% include 'projectsList.liquid' %}
        </div>
      </section>

    </div>
  </div>
</main>