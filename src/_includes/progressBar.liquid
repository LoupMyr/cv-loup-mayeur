{% assign score_num = score | plus: 0 %}
{% if score_num >= 80 %}
  {% assign progress_class = "bg-success" %}
{% else %}
  {% assign progress_class = "bg-warning" %}
{% endif %}

<div class="progress border border-1 border-secondary" style="height: 8px;">
  <div
    class="progress-bar {{ progress_class }}"
    role="progressbar"
    style="width: {{ score }}%;"
    aria-valuenow="{{ score }}"
    aria-valuemin="0"
    aria-valuemax="100"></div>
</div>