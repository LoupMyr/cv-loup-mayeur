{% for interest in cv.interests %}
  <div class="interest-item mb-3">
    <div class="interest-category mb-2">
      {% if interest.icon %}<i class="bi {{ interest.icon }} me-1"></i>{% else %}<i class="bi bi-folder me-1"></i>{% endif %}
      <span class="fw-bold">{{ interest.category }}</span>
    </div>
    <div class="chip-card-grid">
      {% for item in interest.items %}
        <div class="chip-card">
          {% if item.icon %}<i class="bi {{ item.icon }}"></i>{% endif %}
          <span>{{ item.name }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
{% endfor %}
