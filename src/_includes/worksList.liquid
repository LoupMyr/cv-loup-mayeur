{% for work in cv.works %}
  <div class="work-item">
    <div class="work-header d-flex justify-content-between align-items-center mb-2">
      <div class="d-flex align-items-baseline">
        <h4 class="work-position mb-0 fs-4">{{ work.position }}<span class="company-name fs-6">, {{ work.préfixeCompany }}
            {{ work.company }}</span>
        </h4>
      </div>
      <div class="work-dates text-end">{{ work.startDate | date: "%b %Y" }} -
        {% if work.endDate %}
          {{ work.endDate | date: "%b %Y" }}
        {% else %}
          Présent
        {% endif %}
      </div>
    </div>
    <div>
      <p class="work-summary text-secondary fs-6">{{ work.summary }}</p>
    </div>
  </div>
{% endfor %}