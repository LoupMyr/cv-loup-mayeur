<div class="row g-3">
  {% for skill in cv.skills %}
    <div class="col-lg-6 col-12">
      <div class="skill-card">
        <div class="skill-card-header">
          <div class="skill-card-title">
            {% if skill.icon %}<i class="bi {{ skill.icon }}"></i>{% endif %}
            <span class="skill-name">{{ skill.name }}</span>
          </div>
          {% if skill.level == "Avancé" %}
            {% assign level_class = "level-high" %}
          {% elsif skill.level == "Intermédiaire" %}
            {% assign level_class = "level-mid" %}
          {% else %}
            {% assign level_class = "level-low" %}
          {% endif %}
          <span class="skill-level-badge {{ level_class }}">{{ skill.level }}</span>
        </div>
        <div class="skill-tags">
          {% for item in skill.items %}
            <div class="tag">{{ item }}</div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>
