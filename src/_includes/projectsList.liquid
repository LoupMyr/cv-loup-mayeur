{% for project in cv.projects %}
<div class="project-item mb-4">
    {% if project.url %}
    <a href="{{ project.url }}" class="project-link" target="_blank">
        <h4 class="project-name mb-1 fs-4">{{ project.name }}</h4>
        <h5 class="project-nature">Projet {{ project.nature }}</h5>
    </a>
    {% else %}
    <h4 class="project-name mb-1 fs-4">{{ project.name }}</h4>
    {% endif %}

    <p class="project-summary mb-2">{{ project.description }}</p>
    <div class="my-2">
        {% for item in project.technologies %}
        <div class="tag">{{ item }}</div>
        {% endfor %}
    </div>
</div>
{% endfor %}