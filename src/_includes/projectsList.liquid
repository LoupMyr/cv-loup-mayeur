{% for project in cv.projects %}
  <div class="project-item mb-4">
    {% if project.url %}
      <h4 class="project-name mb-1 fs-4">
        <a
          href="{{ project.url }}"
          class="project-link"
          target="_blank">{{ project.name }}</a>
      </h4>
    {% else %}
      <h4 class="project-name mb-1 fs-4 text-primary">{{ project.name }}</h4>
    {% endif %}
    <h5 class="project-nature fs-6 text-light">Projet {{ project.nature }}</h5>

    <p class="project-summary mb-2">{{ project.description }}</p>
    <div class="my-2">
      {% for item in project.technologies %}
        <div class="tag">{{ item }}</div>
      {% endfor %}
    </div>
  </div>
{% endfor %}